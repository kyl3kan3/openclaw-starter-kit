# ── OpenClaw Starter Kit — environment ────────────────────────────────────
# Copy to `.env` and fill in. Never commit your real .env.

# --- Model routing (Ollama-first, escalate only when needed) ---------------
# Small local model for routing + cheap turns (free, runs on-device):
OPENCLAW_LOCAL_MODEL=ollama/llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434

# Optional hosted model for hard tasks. Leave blank to stay 100% local/free.
# Get a key from your provider and uncomment:
# ANTHROPIC_API_KEY=
# OPENCLAW_ESCALATION_MODEL=anthropic/claude-haiku-4-5

# --- Gateway / security -----------------------------------------------------
# Bind to loopback only. Do NOT expose to 0.0.0.0 without a tunnel (Tailscale).
OPENCLAW_BIND=127.0.0.1
OPENCLAW_PORT=8787

# --- Messaging (optional — fill the channel you use) ------------------------
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
